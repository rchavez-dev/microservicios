<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Candidato</title>
</head>
<body>
  <h1>Registrar Nuevo Candidato</h1>
  <form action="/nuevo" method="POST">
    <div>
      <label>CI:</label><br>
      <input type="text" name="ci" maxlength="12" required>
    </div><br>
    <div>
      <label>Nombres:</label><br>
      <input type="text" name="nombres" maxlength="60" required>
    </div><br>
    <div>
      <label>Primer Apellido:</label><br>
      <input type="text" name="apellido1" maxlength="30" required>
    </div><br>
    <div>
      <label>Segundo Apellido:</label><br>
      <input type="text" name="apellido2" maxlength="40">
    </div><br>
    <div>
      <label>Cargo:</label><br>
      <select name="cargo_id" required>
        <option value="">-- Seleccionar Cargo --</option>
        <% cargos.forEach(cg => { %>
          <option value="<%= cg.id %>"><%= cg.nombre %></option>
        <% }) %>
      </select>
    </div><br>
    <div>
      <label>Lugar:</label><br>
      <select name="lugar_id" required>
        <option value="">-- Seleccionar Lugar --</option>
        <% lugares.forEach(l => { %>
          <option value="<%= l.id %>"><%= l.nombre %></option>
        <% }) %>
      </select>
    </div><br>
    <button type="submit">Guardar Candidato</button>
    <a href="/">Cancelar</a>
  </form>
</body>
</html>