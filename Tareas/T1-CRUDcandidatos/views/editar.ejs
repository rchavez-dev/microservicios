<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Candidato</title>
</head>
<body>
  <h1>Editar Candidato (CI: <%= candidato.ci %>)</h1>
  <form action="/editar/<%= candidato.ci %>" method="POST">
    <div>
      <label>Nombres:</label><br>
      <input type="text" name="nombres" value="<%= candidato.nombres %>" maxlength="60" required>
    </div><br>
    <div>
      <label>Primer Apellido:</label><br>
      <input type="text" name="apellido1" value="<%= candidato.apellido1 %>" maxlength="30" required>
    </div><br>
    <div>
      <label>Segundo Apellido:</label><br>
      <input type="text" name="apellido2" value="<%= candidato.apellido2 || '' %>" maxlength="40">
    </div><br>
    <div>
      <label>Cargo:</label><br>
      <select name="cargo_id" required>
        <% cargos.forEach(cg => { %>
          <option value="<%= cg.id %>" <%= candidato.cargo && candidato.cargo.id === cg.id ? 'selected' : '' %>>
            <%= cg.nombre %>
          </option>
        <% }) %>
      </select>
    </div><br>
    <div>
      <label>Lugar:</label><br>
      <select name="lugar_id" required>
        <% lugares.forEach(l => { %>
          <option value="<%= l.id %>" <%= candidato.lugar && candidato.lugar.id === l.id ? 'selected' : '' %>>
            <%= l.nombre %>
          </option>
        <% }) %>
      </select>
    </div><br>
    <button type="submit">Actualizar Candidato</button>
    <a href="/">Cancelar</a>
  </form>
</body>
</html>