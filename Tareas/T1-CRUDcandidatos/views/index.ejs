<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Lista de Candidatos</title>
</head>
<body>
  <h1>Gestión de Candidatos</h1>
  <a href="/nuevo">+ Registrar Nuevo Candidato</a>
  <br><br>
  <table border="1" cellpadding="8" cellspacing="0">
    <thead>
      <tr>
        <th>CI</th>
        <th>Nombres</th>
        <th>Primer Apellido</th>
        <th>Segundo Apellido</th>
        <th>Cargo</th>
        <th>Lugar</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% candidatos.forEach(c => { %>
        <tr>
          <td><%= c.ci %></td>
          <td><%= c.nombres %></td>
          <td><%= c.apellido1 %></td>
          <td><%= c.apellido2 || '' %></td>
          <td><%= c.cargo ? c.cargo.nombre : 'Sin cargo' %></td>
          <td><%= c.lugar ? c.lugar.nombre : 'Sin lugar' %></td>
          <td>
            <a href="/editar/<%= c.ci %>">Editar</a>
            <form action="/eliminar/<%= c.ci %>" method="POST" style="display:inline;">
              <button type="submit" onclick="return confirm('¿Deseas eliminar este candidato?')">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>